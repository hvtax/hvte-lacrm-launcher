{
  "name": "hvte-lacrm-launcher",
  "version": "1.0.0",
  "private": true,
  "description": "Internal Firefox launcher; manifest.json is the release version authority.",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "web-ext lint --config tools/web-ext-config.cjs --self-hosted --warnings-as-errors",
    "build": "web-ext build --config tools/web-ext-config.cjs --overwrite-dest",
    "sign": "node tools/release.mjs sign"
  },
  "devDependencies": { "web-ext": "^10.0.0" }
}
